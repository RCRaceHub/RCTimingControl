{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/oggthemiffed/RCTimingControl/results-export-v1.schema.json",
  "title": "RCTimingControl Results Export v1",
  "description": "An event's results so far, sent by RCTimingControl to RaceHub. Each export carries the whole event; keep the highest revision seen for an event. See docs/results-export-v1.md.",
  "type": "object",
  "required": ["schema_version", "revision", "generated_at", "source", "event", "races", "championships"],
  "additionalProperties": true,
  "properties": {
    "schema_version": { "const": 1 },
    "revision": { "type": "integer", "minimum": 0 },
    "generated_at": { "$ref": "#/$defs/timestamp" },
    "source": {
      "type": "object",
      "required": ["system", "club_name"],
      "properties": {
        "system": { "const": "RCTimingControl" },
        "club_name": { "type": ["string", "null"] }
      }
    },
    "event": {
      "type": "object",
      "required": ["racehub_event_id", "rctc_event_id", "name", "date", "status"],
      "properties": {
        "racehub_event_id": { "type": ["string", "null"] },
        "rctc_event_id": { "type": "integer" },
        "name": { "type": "string" },
        "date": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
        "status": { "enum": ["DRAFT", "PUBLISHED", "OPEN", "ENTRIES_CLOSED", "IN_PROGRESS", "COMPLETED"] }
      }
    },
    "races": { "type": "array", "items": { "$ref": "#/$defs/race" } },
    "championships": { "type": "array", "items": { "$ref": "#/$defs/championship" } }
  },
  "$defs": {
    "timestamp": { "type": "string", "format": "date-time" },
    "race": {
      "type": "object",
      "required": ["rctc_race_id", "rctc_event_class_id", "class_name", "round_type",
        "round_number", "heat_number", "final_letter", "status", "finished_at", "results"],
      "properties": {
        "rctc_race_id": { "type": "integer" },
        "rctc_event_class_id": { "type": "integer" },
        "club_class_ids": {
          "description": "The club class ids (RaceHub club_class_id) of the entries in the race. Left out when the race has none.",
          "type": "array", "minItems": 1, "items": { "type": "string" }, "uniqueItems": true
        },
        "class_name": { "type": "string" },
        "round_type": { "enum": ["PRACTICE", "QUALIFIER", "FINAL"] },
        "round_number": { "type": "integer" },
        "heat_number": { "type": "integer" },
        "final_letter": { "type": ["string", "null"] },
        "status": { "enum": ["FINISHED", "ABANDONED"] },
        "finished_at": { "oneOf": [{ "$ref": "#/$defs/timestamp" }, { "type": "null" }] },
        "results": { "type": "array", "items": { "$ref": "#/$defs/row" } }
      }
    },
    "row": {
      "type": "object",
      "required": ["position", "external_source", "entry_id", "driver_profile_id",
        "rctc_entry_id", "rctc_competitor_id", "display_name", "car_number", "laps", "total_time_ms", "best_lap_ms",
        "penalties"],
      "properties": {
        "position": { "type": "integer", "minimum": 1 },
        "external_source": { "enum": ["RACEHUB", null] },
        "entry_id": { "type": ["string", "null"] },
        "driver_profile_id": { "type": ["string", "null"] },
        "club_class_id": {
          "description": "The entry's club class id. Left out, not null, when it has none, such as a walk-in.",
          "type": "string", "minLength": 1
        },
        "rctc_entry_id": { "type": ["integer", "null"] },
        "rctc_competitor_id": { "type": ["integer", "null"] },
        "display_name": { "type": ["string", "null"] },
        "car_number": { "type": ["string", "null"] },
        "laps": { "type": "integer", "minimum": 0 },
        "total_time_ms": { "type": "integer", "minimum": 0 },
        "best_lap_ms": { "type": ["integer", "null"], "minimum": 0 },
        "penalties": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["type", "value", "reason", "included_in_result"],
            "properties": {
              "type": { "enum": ["LAP", "TIME"] },
              "value": { "type": "number" },
              "reason": { "type": ["string", "null"] },
              "included_in_result": { "type": "boolean" }
            }
          }
        }
      },
      "if": { "properties": { "external_source": { "const": "RACEHUB" } } },
      "then": { "properties": { "entry_id": { "type": "string" }, "driver_profile_id": { "type": "string" } } }
    },
    "championship": {
      "type": "object",
      "required": ["rctc_championship_id", "name", "round_number", "classes"],
      "properties": {
        "rctc_championship_id": { "type": "integer" },
        "name": { "type": "string" },
        "round_number": { "type": "integer" },
        "classes": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["rctc_racing_class_id", "class_name", "standings"],
            "properties": {
              "rctc_racing_class_id": { "type": "integer" },
              "class_name": { "type": ["string", "null"] },
              "standings": { "type": "array", "items": { "$ref": "#/$defs/standing" } }
            }
          }
        }
      }
    },
    "standing": {
      "type": "object",
      "required": ["position", "external_source", "driver_profile_id", "rctc_competitor_id", "display_name",
        "total_points", "round_position", "round_points", "round_dropped", "round_excluded"],
      "properties": {
        "position": { "type": "integer", "minimum": 1 },
        "external_source": { "enum": ["RACEHUB", null] },
        "driver_profile_id": { "type": ["string", "null"] },
        "rctc_competitor_id": { "type": "integer" },
        "display_name": { "type": ["string", "null"] },
        "total_points": { "type": "integer" },
        "round_position": { "type": ["integer", "null"] },
        "round_points": { "type": ["integer", "null"] },
        "round_dropped": { "type": "boolean" },
        "round_excluded": { "type": "boolean" }
      },
      "if": { "properties": { "external_source": { "const": "RACEHUB" } } },
      "then": { "properties": { "driver_profile_id": { "type": "string" } } }
    }
  }
}
